@using MiniCommerce.Models
@{
    ViewData["Title"] = "Accueil";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var produits = ViewBag.ProduitsRecents as IEnumerable<Produit> ?? Enumerable.Empty<Produit>();
}

@{
    var categoryIcons = new Dictionary<string, string>
    {
        ["Informatique"] = "bi-laptop",
        ["Peripheriques"] = "bi-mouse",
        ["Audio"] = "bi-headphones",
        ["Ecrans"] = "bi-display",
        ["Accessoires"] = "bi-plug",
        ["Stockage"] = "bi-hdd",
        ["Reseau"] = "bi-wifi",
        ["Imprimantes"] = "bi-printer"
    };
    var categoryColors = new Dictionary<string, string>
    {
        ["Informatique"] = "#0d6efd",
        ["Peripheriques"] = "#198754",
        ["Audio"] = "#dc3545",
        ["Ecrans"] = "#fd7e14",
        ["Accessoires"] = "#6f42c1",
        ["Stockage"] = "#20c997",
        ["Reseau"] = "#0dcaf0",
        ["Imprimantes"] = "#ffc107"
    };
}

<!-- Hero Section -->
<div class="hero-gradient text-white p-5 rounded-4 mb-5">
    <div class="row align-items-center">
        <div class="col-lg-8">
            <h1 class="display-4 fw-bold mb-3">Bienvenue sur MiniCommerce</h1>
            <p class="lead mb-4">Decouvrez notre selection de produits informatiques au meilleur prix.</p>
            <a asp-controller="Produit" asp-action="Index" class="btn btn-light btn-lg">
                <i class="bi bi-grid"></i> Voir tous les produits
            </a>
        </div>
        <div class="col-lg-4 text-center d-none d-lg-block">
            <i class="bi bi-bag-check-fill" style="font-size: 8rem; opacity: 0.3;"></i>
        </div>
    </div>
</div>

<!-- Categories Section -->
@if (categories.Any())
{
    <h3 class="mb-4"><i class="bi bi-grid-3x3-gap"></i> Nos Categories</h3>
    <div class="row g-4 mb-5">
        @foreach (var cat in categories)
        {
            var icon = categoryIcons.GetValueOrDefault(cat, "bi-tag");
            var color = categoryColors.GetValueOrDefault(cat, "#6c757d");
            <div class="col-6 col-md-4 col-lg-3">
                <a asp-controller="Produit" asp-action="Index" asp-route-categorie="@cat"
                   class="text-decoration-none">
                    <div class="card category-card h-100 text-center p-4 border-0 shadow-sm">
                        <div class="mb-3">
                            <i class="bi @icon" style="font-size: 2.5rem; color: @color;"></i>
                        </div>
                        <h6 class="fw-bold text-dark mb-0">@cat</h6>
                    </div>
                </a>
            </div>
        }
    </div>
}

<!-- Featured Products Section -->
@if (produits.Any())
{
    <h3 class="mb-4"><i class="bi bi-star"></i> Produits Recents</h3>
    <div class="row g-4 mb-5">
        @foreach (var p in produits)
        {
            var catColor = categoryColors.GetValueOrDefault(p.Categorie, "#6c757d");
            <div class="col-6 col-md-4 col-lg-2">
                <div class="card product-card h-100 shadow-sm border-0">
                    <img src="@(p.ImageUrl ?? $"https://picsum.photos/seed/product-{p.Id}/400/300")"
                         class="card-img-top" alt="@p.Nom"
                         style="height: 160px; object-fit: cover;"
                         onerror="this.src='https://picsum.photos/seed/fallback-{p.Id}/400/300'" />
                    <div class="card-body p-3">
                        <span class="badge mb-2" style="background-color: @catColor;">@p.Categorie</span>
                        <h6 class="card-title mb-1" style="font-size: 0.9rem;">@p.Nom</h6>
                        <p class="fw-bold text-primary mb-2">@p.Prix.ToString("C")</p>
                        @if (p.Quantite > 0)
                        {
                            <span class="badge bg-success">En stock</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Rupture</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- CTA -->
<div class="text-center py-4">
    <a asp-controller="Produit" asp-action="Index" class="btn btn-outline-dark btn-lg">
        Voir le catalogue complet <i class="bi bi-arrow-right"></i>
    </a>
</div>
