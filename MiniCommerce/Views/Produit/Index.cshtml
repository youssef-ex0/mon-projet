@model IEnumerable<MiniCommerce.Models.Produit>

@{
    ViewData["Title"] = "Liste des Produits";
    var categories = ViewBag.Categories as List<string> ?? new List<string>();
    var categoryColors = new Dictionary<string, string>
    {
        ["Informatique"] = "#0d6efd",
        ["Peripheriques"] = "#198754",
        ["Audio"] = "#dc3545",
        ["Ecrans"] = "#fd7e14",
        ["Accessoires"] = "#6f42c1",
        ["Stockage"] = "#20c997",
        ["Reseau"] = "#0dcaf0"
    };
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="bi bi-box-seam"></i> Liste des Produits</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Ajouter un produit
    </a>
</div>

<!-- Filters -->
<form asp-action="Index" method="get" class="mb-4">
    <div class="d-flex gap-2 flex-wrap">
        <div class="input-group" style="max-width: 300px;">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" name="searchTerm" value="@ViewBag.SearchTerm"
                   class="form-control" placeholder="Rechercher..." />
            <button type="submit" class="btn btn-outline-secondary">OK</button>
        </div>
        <select name="categorie" class="form-select" style="max-width: 220px;" onchange="this.form.submit()">
            <option value="">-- Toutes categories --</option>
            @foreach (var cat in categories)
            {
                if (cat == ViewBag.CategorieSelectionnee)
                {
                    <option value="@cat" selected>@cat</option>
                }
                else
                {
                    <option value="@cat">@cat</option>
                }
            }
        </select>
        @if (!string.IsNullOrWhiteSpace(ViewBag.SearchTerm) || !string.IsNullOrWhiteSpace(ViewBag.CategorieSelectionnee))
        {
            <a asp-action="Index" class="btn btn-outline-danger">
                <i class="bi bi-x-circle"></i> Effacer filtres
            </a>
        }
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> Aucun produit trouve.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Image</th>
                    <th>Nom</th>
                    <th>Categorie</th>
                    <th>Prix</th>
                    <th>Stock</th>
                    <th style="width: 180px;">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    var catColor = categoryColors.GetValueOrDefault(p.Categorie, "#6c757d");
                    <tr>
                        <td>
                            <img src="@(p.ImageUrl ?? $"https://picsum.photos/seed/product-{p.Id}/100/100")"
                                 alt="@p.Nom" class="rounded"
                                 style="width: 50px; height: 50px; object-fit: cover;"
                                 onerror="this.src='https://picsum.photos/seed/fallback-{p.Id}/100/100'" />
                        </td>
                        <td class="fw-semibold">@p.Nom</td>
                        <td>
                            <span class="badge" style="background-color: @catColor;">@p.Categorie</span>
                        </td>
                        <td class="fw-bold">@p.Prix.ToString("C")</td>
                        <td>
                            @if (p.Quantite <= 5)
                            {
                                <span class="badge bg-danger">@p.Quantite</span>
                            }
                            else
                            {
                                @p.Quantite
                            }
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
