@model MiniCommerce.Models.Produit

@{
    ViewData["Title"] = "Ajouter un Produit";
}

<h2><i class="bi bi-plus-circle"></i> Ajouter un Produit</h2>

<form asp-action="Create" method="post" class="mt-3" style="max-width: 500px;">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Nom" class="form-label"></label>
        <input asp-for="Nom" class="form-control" />
        <span asp-validation-for="Nom" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Categorie" class="form-label"></label>
        <input asp-for="Categorie" class="form-control" list="categorie-list" />
        <datalist id="categorie-list">
            @foreach (var cat in ViewBag.Categories)
            {
                <option value="@cat" />
            }
        </datalist>
        <span asp-validation-for="Categorie" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Prix" class="form-label"></label>
        <input asp-for="Prix" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Prix" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Quantite" class="form-label"></label>
        <input asp-for="Quantite" class="form-control" type="number" />
        <span asp-validation-for="Quantite" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ImageUrl" class="form-label"></label>
        <input asp-for="ImageUrl" class="form-control" type="url" placeholder="https://example.com/image.jpg" />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
        <div class="form-text">Collez l'URL d'une image (optionnel)</div>
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-success"><i class="bi bi-check-lg"></i> Enregistrer</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Annuler</a>
    </div>
</form>
